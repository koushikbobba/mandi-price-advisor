      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "pieType": "pie",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "Decision Confidence Distribution",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (level) (mandi_confidence_total)",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
